# ---------------------------------------------------------------------------
# AnyChat environment template.
# Local dev:  copy the "Local dev" values into apps/api/.env (already gitignored).
# Compose:    copy this file to deploy/.env (gitignored) and change passwords.
# ---------------------------------------------------------------------------

# ---- Compose (deploy/.env) -------------------------------------------------
POSTGRES_USER=anychat
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=anychat
REDIS_PASSWORD=change-me-strong
# Public origin of the app (used for links/audit metadata; set to https://...):
API_BASE_URL=http://localhost:3001
# Number of reverse-proxy hops in front of the API (nginx/caddy = 1):
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# ---- Meta / encryption (compose + API; Phase 2) ----------------------------
# AES-256-GCM key for sealing Meta tokens at rest (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never rotate casually — resealing existing credentials requires reconnection.
APP_ENCRYPTION_KEY=
# Rotation grace: previous keys (comma-separated base64) kept for decryption
# only; re-save secrets via the Connections page to reseal, then remove.
APP_ENCRYPTION_KEY_OLD=
# Public origin the API uses for OAuth redirect + webhook callback URLs
# (must match the domain registered in the Meta App Dashboard):
PUBLIC_BASE_URL=https://anychat.example.com
# Meta App credentials (from developers.facebook.com; leave empty until configured):
META_APP_ID=
META_APP_SECRET=
# Verify token Facebook sends back on GET challenge (choose a long random string):
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version pin (default v26.0 if unset):
META_GRAPH_VERSION=v26.0

# ---- Local dev API (apps/api/.env) ----------------------------------------
DATABASE_URL=postgresql://anychat:anychat-dev@127.0.0.1:15432/anychat?schema=public
REDIS_URL=redis://:anychat-dev@127.0.0.1:6379/0
API_PORT=4000

# ---- Local dev Web (apps/web environment) ---------------------------------
# Next.js rewrites /api/* to this target:
API_PROXY_TARGET=http://localhost:4000

# ---- Tests (optional overrides; defaults target the local compose dev DB) --
# TEST_DATABASE_URL=postgresql://anychat:anychat-dev@127.0.0.1:5432/anychat_test?schema=public
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# TEST_REDIS_URL=redis://127.0.0.1:6379/1
