{
  "name": "anychat",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm --filter api test:e2e",
    "admin:bootstrap": "node apps/api/dist/cli/bootstrap.js",
    "admin:reset-password": "node apps/api/dist/cli/reset-password.js",
    "admin:new-recovery": "node apps/api/dist/cli/new-recovery.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
