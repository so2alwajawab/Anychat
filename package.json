{
  "name": "anychat",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter api test:e2e",
    "test:all": "pnpm -r test && pnpm --filter api test:e2e",
    "admin:bootstrap": "node apps/api/dist/cli/bootstrap.js",
    "admin:reset-password": "node apps/api/dist/cli/reset-password.js",
    "admin:new-recovery": "node apps/api/dist/cli/new-recovery.js",
    "admin:rotate-key": "node apps/api/dist/cli/reencrypt.js",
    "admin:restore-drill": "node apps/api/dist/cli/backup-drill.js",
    "admin:monitor": "node apps/api/dist/cli/monitor.js",
    "admin:load-test": "node apps/api/dist/cli/load-test.js",
    "meta:diag-subscribe": "node apps/api/dist/cli/subscribe-diag.js",
    "meta:spike-private-reply": "node apps/api/dist/cli/private-reply-spike.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
